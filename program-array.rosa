main() {
    array numbers
    array_push(numbers, 10)
    array_push(numbers, 20)
    array_push(numbers, 30)
    
    print(array_length(numbers))
    
    print(array_get(numbers, 0))
    print(array_get(numbers, 1))
    print(array_get(numbers, 2))
    
    array_set(numbers, 1, 99)
    
    print(array_get(numbers, 1))
    
    array_pop(numbers)
    
    print(array_length(numbers))
    
    print(array_get(numbers, 0))
    print(array_get(numbers, 1))
}
