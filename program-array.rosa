main() {
    array numbers
    push(numbers, 10)
    push(numbers, 20)
    push(numbers, 30)
    
    print(length(numbers))
    
    print(get(numbers, 0))
    print(get(numbers, 1))
    print(get(numbers, 2))
    
    set(numbers, 1, 99)
    
    print(get(numbers, 1))
    
    pop(numbers)
    
    print(length(numbers))
    
    print(get(numbers, 0))
    print(get(numbers, 1))
}
