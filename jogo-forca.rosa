main() {
    array palavras
    array_push(palavras, "casa")
    array_push(palavras, "carro")
    array_push(palavras, "livro")
    array_push(palavras, "computador")
    array_push(palavras, "telefone")
    array_push(palavras, "mesa")
    array_push(palavras, "cadeira")
    array_push(palavras, "janela")
    array_push(palavras, "porta")
    array_push(palavras, "escola")
    array_push(palavras, "trabalho")
    array_push(palavras, "familia")
    array_push(palavras, "amigo")
    array_push(palavras, "comida")
    array_push(palavras, "agua")
    array_push(palavras, "sol")
    array_push(palavras, "lua")
    array_push(palavras, "estrela")
    array_push(palavras, "flores")
    array_push(palavras, "musica")

    int escolha = 0
    print("Escolha um numero de 1 a 20")
    escolha = read_int()
    is (escolha < 1 ) {
        print("Numero invalido")
    }
    is (escolha > 20) {
        print("Numero invalido")
    }
    escolha = escolha - 1

    string palavra = array_get(palavras, escolha)

    string input = ""
    int tentativa = 0

    int comprimento = 0
    comprimento = length(palavra)
    
    array pedacos
    int deslocamento = 0
    int laco = 10
    string letra = ""
    boolean comparacao = false
    aslong (laco >= 0) {
        laco = laco - 1

        is (array_length(pedacos) == comprimento) {
            print("Palavra completa!")
            goto fim
        }

        print("Chute uma letra:")
        input = read_string()
        
        letra = charat(palavra, deslocamento)
        comparacao = compare(letra, input)
        is (comparacao == true) {
            deslocamento = deslocamento + 1
            array_push(pedacos, letra)
            print("Voce acertou uma letra! ")
        }
        not {
            print("Voce errou!")
        }

        print("Quantidade de tentativas restantes: ")
        print(laco)
    }

    is (array_length(pedacos) == comprimento) {
        goto perdeu
    }

    label perdeu:
    print("Voce perdeu!")

    label fim:
    print("A palavra era: ")
    print(palavra)
    print("=== FIM DE JOGO ===")
}