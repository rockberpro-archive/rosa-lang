procedure factorial(int n)
{
    int result = 1
    int i = 1
    aslong(i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

main() {
    print("Digite um numero para calcular seu fatorial:")
    int numero = read_int()
    int result = call factorial(numero)
    print("Fatorial:")
    print(result)
}
