procedure sum() {
    return 5 + 10
}

procedure times() {
    return 2 * 5
}

main() {
    int sum = call sum()
    int times = call times()
    print(sum)
    print(times)

    int x = 0
    aslong(x <= 10) {
        x = x + 1
        print(x)
    }

    int a = 1
    int b = 2
    int c = a + b
    is (c == 3) {
        print("c is 3")
    }
    or (c == 4) {
        print("c is 4")
    }
    or (c == 5) {
        print("c is 5")
    }
    not {
        print("c is something else")
    }
}
